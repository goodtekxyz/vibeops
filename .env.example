# Local secrets for vibeops maintainers (never commit real values).
# Prefer Infisical: env local, path /, key NPM_TOKEN
#
#   export INFISICAL_API_URL=https://infisical.goodtek.xyz
#   infisical login && infisical init
#   # create NPM_TOKEN in Infisical (root path /)
#   pnpm publish:npm
#
# Fallback:
#   cp .env.example .env
#   # paste granular npm token (bypass 2FA enabled)

NPM_TOKEN=
# Optional one-shot OTP if the token does not bypass 2FA:
# NPM_OTP=
