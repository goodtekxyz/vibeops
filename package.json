{
  "name": "vibeops",
  "version": "0.1.0",
  "description": "VibeOps — Cursor 기반 바이브 코딩을 체계적으로 굴리는 로컬 CLI.",
  "type": "module",
  "private": true,
  "bin": {
    "vibeops": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
